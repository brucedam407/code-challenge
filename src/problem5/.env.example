# Copy to .env and adjust. Every value below is also the built-in default,
# so the server runs with no .env file at all.

PORT=4001
NODE_ENV=development

# SQLite file. ':memory:' keeps everything in RAM (used by the test suite).
DATABASE_FILE=./data/app.db

# How many recent minutes count as online.

# Max page size accepted by GET /api/users.
MAX_PAGE_SIZE=100

# How many users one client may create per window.
CREATE_RATE_LIMIT=10
CREATE_RATE_WINDOW_SECONDS=60

# Set to 'silent' to mute request logs (the test suite does this).
LOG_LEVEL=info
